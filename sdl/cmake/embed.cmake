# Turns a file into a C++ source that defines its bytes:
#
#   cmake -DINPUT=<file> -DOUTPUT=<file.cpp> -DNAME=<symbol> -P embed.cmake
#
# defines, with external linkage,
#
#   const unsigned char <symbol>[];
#   const size_t <symbol>_size;

if(NOT INPUT OR NOT OUTPUT OR NOT NAME)
    message(FATAL_ERROR "embed.cmake needs INPUT, OUTPUT and NAME")
endif()

file(READ "${INPUT}" hex HEX)
string(REGEX REPLACE "(................................)" "\\1\n" hex "${hex}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")

get_filename_component(file "${INPUT}" NAME)
file(WRITE "${OUTPUT}" "// ${file}, generated by embed.cmake
#include <cstddef>

extern const unsigned char ${NAME}[];
extern const size_t ${NAME}_size;

const unsigned char ${NAME}[] = {
${hex}
};
const size_t ${NAME}_size = sizeof(${NAME});
")
